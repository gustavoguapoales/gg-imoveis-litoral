{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gg-imoveis-litoral",
  "main": ".open-next/worker.js",
  // A Cloudflare roda `npx wrangler deploy`; antes disso, este comando gera o Worker com o OpenNext.
  "build": { "command": "npx opennextjs-cloudflare build" },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Referência ao próprio Worker, exigida pelo OpenNext.
    { "binding": "WORKER_SELF_REFERENCE", "service": "gg-imoveis-litoral" }
  ],
  // Imóveis (dados públicos e privados separados), registro de fotos e de acessos ao painel.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gg-imoveis",
      "database_id": "9378b9c3-38b6-4d62-809c-150741349e5e",
      "migrations_dir": "migrations"
    }
  ],
  // Fotos enviadas pelo painel.
  "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "gg-imoveis-fotos" }],
  // Aviso de login no painel (só pode enviar para este endereço verificado).
  "send_email": [{ "name": "EMAIL", "destination_address": "gustavo.guapo70@gmail.com" }],
  "vars": {
    // E-mail que recebe o aviso de login. A senha (hash) e a chave das sessões são segredos
    // guardados na Cloudflare (PAINEL_SENHA_HASH e SESSAO_CHAVE), nunca neste arquivo.
    "PAINEL_EMAIL": "gustavo.guapo70@gmail.com"
  },
  "observability": { "enabled": false }
}
